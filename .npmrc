# Fait échouer l'installation si Node ou npm ne correspondent pas au champ
# `engines` de package.json.
#
# Pourquoi : npm 10 et npm 11 ne résolvent pas identiquement les sous-arbres
# optionnels par plateforme (le repli wasm32-wasi de `satteri`, notamment).
# Un lockfile écrit par npm 11 fait échouer `npm ci` sous npm 10 avec un
# « Missing: @emnapi/runtime@x.y.z from lock file » parfaitement opaque.
#
# Avec ce réglage, le message devient explicite : « Unsupported engine ».
engine-strict=true
