---
/**
 * Cosmos — le fond permanent du site.
 *
 * Un unique quad plein écran rendu par un fragment shader : nébuleuse FBM +
 * trois couches d'étoiles parallaxées. Écrit en WebGL brut (≈ 4 ko de JS,
 * zéro dépendance) parce que three.js pour afficher deux triangles serait
 * 150 ko gaspillés sur le chemin critique de CHAQUE page.
 *
 * Garde-fous : rendu à résolution réduite, mise en pause hors écran et
 * onglet caché, coupure totale si `prefers-reduced-motion` ou pas de WebGL —
 * un dégradé CSS statique prend alors le relais et personne ne voit la
 * différence sur un screenshot.
 */
interface Props {
  /** Intensité globale, 0 → 1. Baissée sur les pages de lecture. */
  intensity?: number;
}
const { intensity = 1 } = Astro.props;
---

<div class="cosmos" aria-hidden="true" data-intensity={intensity}>
  <canvas class="cosmos__canvas"></canvas>
</div>

<style>
  .cosmos {
    position: fixed;
    inset: 0;
    z-index: -10;
    pointer-events: none;
    /* Repli statique : visible tant que le shader n'a pas pris la main, et
       définitivement si WebGL est indisponible. Il porte déjà la composition
       du site — halo chaud en bas, vide froid en haut. */
    background:
      radial-gradient(
        95% 62% at 50% 110%,
        color-mix(in oklab, var(--color-gold-700) 42%, transparent) 0%,
        transparent 58%
      ),
      radial-gradient(
        90% 60% at 12% 8%,
        color-mix(in oklab, var(--color-nebula-900) 70%, transparent) 0%,
        transparent 70%
      ),
      radial-gradient(
        70% 50% at 88% 22%,
        color-mix(in oklab, var(--color-astral-800) 55%, transparent) 0%,
        transparent 70%
      ),
      var(--color-void);
  }

  /* Repli du dialecte cristal : la sève en bas à gauche, le tourbillon
     magenta très loin en haut à droite, le vide violet. */
  :global([data-dialect='cristal']) .cosmos {
    background:
      radial-gradient(70% 75% at 16% 104%, rgb(196 242 74 / 0.16) 0%, rgb(160 208 58 / 0.06) 28%, transparent 55%),
      radial-gradient(62% 62% at 84% 12%, rgb(240 82 176 / 0.16) 0%, rgb(144 103 240 / 0.08) 38%, transparent 70%),
      radial-gradient(50% 50% at 60% 74%, rgb(79 208 245 / 0.07) 0%, transparent 60%),
      linear-gradient(225deg, #07050f 0%, #0a0716 35%, #0e0a1d 62%, #140f26 85%, #1b1530 100%);
  }

  .cosmos__canvas {
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1.6s var(--ease-cosmic);
  }
  .cosmos__canvas[data-live] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .cosmos__canvas {
      display: none;
    }
  }
</style>

<script>
  const VERT = `
    attribute vec2 aPos;
    void main() { gl_Position = vec4(aPos, 0.0, 1.0); }
  `;

  const FRAG = `
    precision highp float;

    uniform vec2  uRes;
    uniform float uTime;
    uniform vec2  uPointer;
    uniform float uScroll;
    uniform float uIntensity;

    // Palette du dialecte (posée une fois au démarrage, voir PALETTES).
    uniform vec3  uNebA;      // fond de la nébuleuse
    uniform vec3  uNebB;      // seconde teinte de la nébuleuse
    uniform vec3  uNebC;      // reflet de la source dans la nébuleuse
    uniform vec2  uSun;       // position de la source, en uv (0..1, y vers le haut)
    uniform vec2  uSunSquash; // aplatissement de sa retombée
    uniform vec3  uSunCol;    // nappe
    uniform vec3  uSunCore;   // cœur serré
    uniform vec2  uSunGain;   // intensités nappe / cœur
    uniform vec3  uAuxPos[2]; // deux lueurs secondaires : xy en uv, z = décroissance
    uniform vec3  uAuxCol[2]; // leur couleur, déjà multipliée par leur intensité
    uniform vec3  uStar;      // teinte des étoiles
    uniform vec3  uFloor;     // plancher du vide (jamais du noir pur)
    uniform float uGround;    // sol glacé au ras du bas (dialecte cristal)

    // --- Bruit ------------------------------------------------------------
    float hash21(vec2 p) {
      p = fract(p * vec2(123.34, 456.21));
      p += dot(p, p + 45.32);
      return fract(p.x * p.y);
    }

    float noise(vec2 p) {
      vec2 i = floor(p);
      vec2 f = fract(p);
      vec2 u = f * f * (3.0 - 2.0 * f);
      float a = hash21(i);
      float b = hash21(i + vec2(1.0, 0.0));
      float c = hash21(i + vec2(0.0, 1.0));
      float d = hash21(i + vec2(1.0, 1.0));
      return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
    }

    // Fractal Brownian Motion : 5 octaves, rotation entre chaque pour casser
    // l'alignement sur la grille (sinon on voit un damier dans la nébuleuse).
    float fbm(vec2 p) {
      float v = 0.0;
      float amp = 0.5;
      mat2 rot = mat2(0.80, 0.60, -0.60, 0.80);
      for (int i = 0; i < 5; i++) {
        v += amp * noise(p);
        p = rot * p * 2.03;
        amp *= 0.5;
      }
      return v;
    }

    // --- Étoiles ----------------------------------------------------------
    // Grille de cellules, une étoile potentielle par cellule, décalée
    // aléatoirement à l'intérieur pour éviter la régularité.
    float starLayer(vec2 uv, float density, float t, float seed) {
      vec2 g  = uv * density + seed;
      vec2 id = floor(g);
      vec2 gv = fract(g) - 0.5;
      float h = hash21(id + seed);
      float present = step(0.945, h);
      vec2 off = vec2(hash21(id + 1.7), hash21(id + 3.3)) - 0.5;
      float d = length(gv - off * 0.72);
      float size = mix(0.010, 0.038, hash21(id + 9.1));
      float core = smoothstep(size, 0.0, d);
      float halo = smoothstep(size * 4.5, 0.0, d) * 0.22;
      float tw = 0.5 + 0.5 * sin(t * 1.4 + h * 62.0);
      return (core + halo) * present * tw;
    }

    void main() {
      vec2 frag = gl_FragCoord.xy;
      vec2 uv = frag / uRes;
      float aspect = uRes.x / uRes.y;
      vec2 p = (uv - 0.5) * vec2(aspect, 1.0);

      float t = uTime;
      // Parallaxe : le pointeur et le scroll déplacent les couches de fond
      // moins vite que le contenu. C'est ce décalage qui crée la profondeur.
      vec2 par = uPointer * 0.03;

      // --- Nébuleuse ---
      vec2 np = p * 1.9 + par;
      float n1 = fbm(np + vec2(t * 0.015, t * 0.009 - uScroll * 0.25));
      float n2 = fbm(np * 1.8 + n1 * 1.2 - vec2(t * 0.011, 0.0));
      float mask = smoothstep(0.28, 0.95, n2);

      vec3 col = mix(uNebA, uNebB, smoothstep(0.15, 0.85, n1));
      col = mix(col, uNebC, pow(mask, 2.2) * 0.32);
      col *= mask * 0.85;

      // --- Source de lumière dorée, en bas ---
      // Toute la direction artistique du site tient à ça : UNE source chaude,
      // basse, hors champ. Le reste du cadre est sa retombée.
      //
      // La décroissance est volontairement RAPIDE (exp(-3.1·d) et non -2.15).
      // Une retombée trop lente ne se lit plus comme une source lumineuse :
      // elle devient un filtre doré posé sur tout l'écran, qui fait jaunir
      // le contenu par-dessus. Une source doit avoir un bord.
      vec2 sun = (uSun + vec2(0.0, uScroll * 0.22) - 0.5) * vec2(aspect, 1.0);
      float sd = length((p - sun) * uSunSquash);
      float glow = exp(-sd * 3.1);
      col += uSunCol * glow * uSunGain.x;
      // Cœur serré : c'est lui qui porte l'intensité, pas la nappe large.
      col += uSunCore * exp(-sd * 6.5) * uSunGain.y;

      // Lueurs secondaires (cristal : le tourbillon lointain en haut à droite,
      // la lueur glacée au sol). Éteintes dans le dialecte doré.
      for (int i = 0; i < 2; i++) {
        vec2 ap = (uAuxPos[i].xy - 0.5) * vec2(aspect, 1.0);
        col += uAuxCol[i] * exp(-length(p - ap) * uAuxPos[i].z);
      }

      // --- Étoiles, trois profondeurs ---
      vec2 su = p + par * 0.35;
      float s = 0.0;
      s += starLayer(su * 1.00, 11.0, t, 0.0)  * 1.00;
      s += starLayer(su * 1.55, 17.0, t, 7.3)  * 0.62;
      s += starLayer(su * 2.30, 26.0, t, 21.9) * 0.36;
      // Les étoiles s'effacent dans le halo : rien ne brille dans un soleil.
      s *= 1.0 - clamp(glow * 1.5, 0.0, 0.9);
      col += uStar * s * 0.85;

      // Le sol de la vallée : une bande glacée très pâle au ras du bas.
      col += vec3(0.725, 0.765, 0.902) * smoothstep(0.86, 1.0, 1.0 - uv.y) * uGround;

      // --- Vignette ---
      float vig = 1.0 - smoothstep(0.45, 1.25, length(p * vec2(0.85, 1.0)));
      col *= mix(0.35, 1.0, vig);

      // Plancher très sombre mais jamais noir pur : garde de la matière.
      col = max(col, uFloor);
      col *= uIntensity;

      // Dithering : casse le banding sur les larges dégradés sombres.
      float dither = (hash21(frag) - 0.5) / 255.0;
      gl_FragColor = vec4(col + dither, 1.0);
    }
  `;

  type Vec3 = [number, number, number];
  interface Palette {
    nebA: Vec3; nebB: Vec3; nebC: Vec3;
    sun: [number, number]; squash: [number, number];
    sunCol: Vec3; sunCore: Vec3; sunGain: [number, number];
    aux: [number, number, number, number, number, number];
    auxCol: [number, number, number, number, number, number];
    star: Vec3; floor: Vec3; ground: number;
    /** Cadence plafond quand rien ne bouge (0 : aucune limite). */
    calmFps: number;
  }

  // Une palette par dialecte. La composition (une source, une retombée qui a
  // un bord, une vignette) ne change pas : seule la matière change.
  const PALETTES: Record<string, Palette> = {
    cosmos: {
      nebA: [0.045, 0.105, 0.28], nebB: [0.17, 0.075, 0.33], nebC: [0.52, 0.33, 0.085],
      sun: [0.5, -0.28], squash: [0.68, 1.0],
      sunCol: [0.95, 0.66, 0.24], sunCore: [1.0, 0.86, 0.55], sunGain: [0.46, 0.3],
      aux: [0, 0, 99, 0, 0, 99], auxCol: [0, 0, 0, 0, 0, 0],
      star: [0.92, 0.94, 1.0], floor: [0.016, 0.021, 0.043], ground: 0,
      calmFps: 0,
    },
    // Graine/Themes/Cristal.xaml : SeedGlowBrush (0.16, 1.04 → uv 0.16, -0.04),
    // VortexGlowBrush (0.84, 0.12 → uv 0.84, 0.88), CrystalGlowBrush (0.6, 0.74).
    cristal: {
      nebA: [0.05, 0.03, 0.13], nebB: [0.2, 0.06, 0.3], nebC: [0.1, 0.38, 0.52],
      sun: [0.16, -0.06], squash: [0.62, 0.9],
      sunCol: [0.62, 0.86, 0.2], sunCore: [0.89, 1.0, 0.54], sunGain: [0.22, 0.1],
      aux: [0.84, 0.9, 1.7, 0.6, 0.26, 2.6],
      auxCol: [0.17, 0.05, 0.13, 0.03, 0.09, 0.13],
      star: [0.93, 0.92, 0.97], floor: [0.027, 0.02, 0.059], ground: 0.08,
      // Le ciel de la Graine est calme : la nébuleuse dérive en une à deux
      // minutes, rien n'y demande 60 images par seconde. 12 i/s au repos,
      // pleine cadence seulement pendant que la parallaxe rattrape le pointeur.
      calmFps: 12,
    },
  };

  function boot() {
    const host = document.querySelector<HTMLElement>('.cosmos');
    const canvas = host?.querySelector<HTMLCanvasElement>('.cosmos__canvas');
    if (!host || !canvas) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const gl = canvas.getContext('webgl', {
      alpha: false,
      antialias: false,
      depth: false,
      stencil: false,
      powerPreference: 'low-power',
    });
    if (!gl) return; // le dégradé CSS reste en place

    const compile = (type: number, src: string) => {
      const sh = gl.createShader(type)!;
      gl.shaderSource(sh, src);
      gl.compileShader(sh);
      if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) {
        console.warn('[cosmos]', gl.getShaderInfoLog(sh));
        return null;
      }
      return sh;
    };

    const vs = compile(gl.VERTEX_SHADER, VERT);
    const fs = compile(gl.FRAGMENT_SHADER, FRAG);
    if (!vs || !fs) return;

    const prog = gl.createProgram()!;
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(
      gl.ARRAY_BUFFER,
      new Float32Array([-1, -1, 3, -1, -1, 3]), // un seul grand triangle couvrant
      gl.STATIC_DRAW,
    );
    const loc = gl.getAttribLocation(prog, 'aPos');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const uRes = gl.getUniformLocation(prog, 'uRes');
    const uTime = gl.getUniformLocation(prog, 'uTime');
    const uPointer = gl.getUniformLocation(prog, 'uPointer');
    const uScroll = gl.getUniformLocation(prog, 'uScroll');
    const uIntensity = gl.getUniformLocation(prog, 'uIntensity');

    gl.uniform1f(uIntensity, Number(host.dataset.intensity ?? 1));

    const palette = PALETTES[document.documentElement.dataset.dialect ?? 'cosmos'] ?? PALETTES.cosmos;
    const u = (name: string) => gl.getUniformLocation(prog, name);
    gl.uniform3fv(u('uNebA'), palette.nebA);
    gl.uniform3fv(u('uNebB'), palette.nebB);
    gl.uniform3fv(u('uNebC'), palette.nebC);
    gl.uniform2fv(u('uSun'), palette.sun);
    gl.uniform2fv(u('uSunSquash'), palette.squash);
    gl.uniform3fv(u('uSunCol'), palette.sunCol);
    gl.uniform3fv(u('uSunCore'), palette.sunCore);
    gl.uniform2fv(u('uSunGain'), palette.sunGain);
    gl.uniform3fv(u('uAuxPos'), palette.aux);
    gl.uniform3fv(u('uAuxCol'), palette.auxCol);
    gl.uniform3fv(u('uStar'), palette.star);
    gl.uniform3fv(u('uFloor'), palette.floor);
    gl.uniform1f(u('uGround'), palette.ground);

    // La nébuleuse est floue par nature : la rendre en pleine résolution
    // rétine ne se voit pas et quadruple le coût. 0.65× suffit.
    const SCALE = 0.65;
    const DPR_MAX = 1.5;

    let w = 0;
    let h = 0;
    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, DPR_MAX) * SCALE;
      const nw = Math.max(1, Math.floor(host.clientWidth * dpr));
      const nh = Math.max(1, Math.floor(host.clientHeight * dpr));
      if (nw === w && nh === h) return;
      w = nw;
      h = nh;
      canvas.width = w;
      canvas.height = h;
      gl.viewport(0, 0, w, h);
      gl.uniform2f(uRes, w, h);
    };
    resize();
    addEventListener('resize', resize, { passive: true });

    // Pointeur et scroll sont lissés : une valeur brute donne un fond
    // nerveux qui « colle » au curseur et trahit l'illusion de distance.
    let px = 0, py = 0, tx = 0, ty = 0;
    addEventListener(
      'pointermove',
      (e) => {
        tx = (e.clientX / innerWidth - 0.5) * 2;
        ty = (e.clientY / innerHeight - 0.5) * 2;
      },
      { passive: true },
    );

    let scroll = 0, tScroll = 0;
    const readScroll = () => {
      const max = Math.max(1, document.body.scrollHeight - innerHeight);
      tScroll = Math.min(1, scrollY / max);
    };
    addEventListener('scroll', readScroll, { passive: true });
    readScroll();

    let running = true;
    let raf = 0;
    const start = performance.now();

    let lastDraw = 0;
    const frame = (now: number) => {
      raf = requestAnimationFrame(frame);
      if (!running) return;

      // Lissage exprimé en temps, pas en images : à 12 i/s comme à 165, la
      // parallaxe rattrape le pointeur à la même vitesse.
      const dt = Math.min(0.1, (now - (lastDraw || now)) / 1000) || 1 / 60;
      const settling =
        Math.abs(tx - px) + Math.abs(ty - py) + Math.abs(tScroll - scroll) > 0.0015;
      // Régime calme : tant que rien ne rattrape rien, on ne redessine qu'à la
      // cadence plafond du dialecte. Le reste du temps, pleine cadence.
      if (palette.calmFps > 0 && !settling && now - lastDraw < 1000 / palette.calmFps) return;
      lastDraw = now;

      px += (tx - px) * (1 - Math.pow(1 - 0.045, dt * 60));
      py += (ty - py) * (1 - Math.pow(1 - 0.045, dt * 60));
      scroll += (tScroll - scroll) * (1 - Math.pow(1 - 0.08, dt * 60));
      gl.uniform1f(uTime, (now - start) / 1000);
      gl.uniform2f(uPointer, px, -py);
      gl.uniform1f(uScroll, scroll);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };
    raf = requestAnimationFrame(frame);

    // Onglet caché = zéro frame. Un fond animé qui tourne dans un onglet
    // inactif, c'est de la batterie brûlée pour rien.
    document.addEventListener('visibilitychange', () => {
      running = !document.hidden;
    });

    canvas.dataset.live = '';

    // Astro remplace le DOM entre deux pages (View Transitions) : on libère
    // le contexte WebGL, sinon le navigateur en accumule et coupe les plus vieux.
    document.addEventListener(
      'astro:before-swap',
      () => {
        cancelAnimationFrame(raf);
        removeEventListener('resize', resize);
        removeEventListener('scroll', readScroll);
        gl.getExtension('WEBGL_lose_context')?.loseContext();
      },
      { once: true },
    );
  }

  document.addEventListener('astro:page-load', boot);
</script>
