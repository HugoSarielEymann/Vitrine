---
import { NAV, SITE, SOCIALS } from '../consts';
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="foot__horizon" aria-hidden="true"></div>

  <div class="shell foot__inner">
    <div class="foot__brand">
      <p class="foot__name gilded">{SITE.name}</p>
      <p class="foot__tag">{SITE.tagline}</p>
    </div>

    <nav class="foot__col" aria-label="Pages">
      <h2 class="foot__title">Navigation</h2>
      {NAV.map((i) => <a href={i.href}>{i.label}</a>)}
    </nav>

    <nav class="foot__col" aria-label="Liens externes">
      <h2 class="foot__title">Ailleurs</h2>
      {
        SOCIALS.map((s) => (
          <a href={s.href} rel="me noopener" target={s.href.startsWith('http') ? '_blank' : undefined}>
            {s.label}
          </a>
        ))
      }
    </nav>

    <nav class="foot__col" aria-label="Informations légales">
      <h2 class="foot__title">Légal</h2>
      <a href="/mentions-legales">Mentions légales</a>
      <a href="/rss.xml">Flux RSS</a>
    </nav>
  </div>

  <div class="shell foot__base">
    <p>© {year} {SITE.name}. Tous droits réservés.</p>
    <p class="foot__built">Astro · Tailwind · WebGL — hébergé sur Cloudflare</p>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    margin-top: 5rem;
    padding-top: 3rem;
    isolation: isolate;
  }

  /* Dégradé transparent → or, du haut vers le bas. Le site ne se termine pas
     sur une bordure : il s'échoue dans la lumière dont il est éclairé depuis
     le début. Les paliers restent en alpha faible — un or opaque écraserait
     le texte posé dessus. */
  .foot__horizon {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      color-mix(in oklab, var(--color-gold-800) 14%, transparent) 42%,
      color-mix(in oklab, var(--color-gold-700) 28%, transparent) 72%,
      color-mix(in oklab, var(--color-gold-500) 34%, transparent) 100%
    );
  }
  /* Filet lumineux d'entrée : marque la limite sans trait gris. */
  .foot__horizon::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in oklab, var(--color-gold-400) 55%, transparent) 50%,
      transparent
    );
  }

  .foot__inner {
    position: relative;
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    padding-bottom: 2rem;
  }
  @media (width >= 48rem) {
    .foot__inner { grid-template-columns: 1.6fr repeat(3, 1fr); gap: 1.75rem; }
  }

  .foot__name {
    font-family: var(--font-display);
    font-weight: 500;
    /* Jost se pose à 80 % (global.css) ; un nom court, de taille moyenne,
       ne perd qu'un dixième. */
    font-size: calc(var(--step-1) * 1.125);
    line-height: 1;
  }
  .foot__tag {
    margin-top: 0.6rem;
    max-width: 30ch;
    color: var(--color-ink-500);
    font-size: 0.88rem;
  }

  .foot__col { display: flex; flex-direction: column; gap: 0.45rem; }
  .foot__title {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-gold-400);
    margin-bottom: 0.25rem;
  }
  .foot__col a {
    font-size: 0.88rem;
    color: var(--color-ink-300);
    width: fit-content;
    transition: color 0.25s, translate 0.25s var(--ease-cosmic);
  }
  .foot__col a:hover { color: var(--color-gold-100); translate: 3px 0; }

  .foot__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    padding-block: 1rem 1.25rem;
    /* Séparateur doré translucide : un gris franc trancherait sur le dégradé. */
    border-top: 1px solid color-mix(in oklab, var(--color-gold-300) 22%, transparent);
    font-size: 0.74rem;
    /* Sur le bas du dégradé, ink-500 passe juste sous le seuil de lisibilité. */
    color: color-mix(in oklab, var(--color-ink-300) 82%, transparent);
  }
  .foot__built { font-family: var(--font-mono); letter-spacing: 0.04em; }
</style>
