---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Reveal from '../../components/Reveal.astro';
import StatusPill from '../../components/StatusPill.astro';

export async function getStaticPaths() {
  const logiciels = await getCollection('logiciels');
  return logiciels.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Tutoriels rattachés à ce logiciel — la relation se lit dans le frontmatter
// du tutoriel, pas ici : ajouter un tutoriel n'oblige jamais à toucher la fiche.
const tutoriels = (await getCollection('tutoriels', ({ data }) => !data.draft))
  .filter((t) => t.data.logiciel === entry.id)
  .sort((a, b) => a.data.duration - b.data.duration);
---

<Base title={entry.data.title} description={entry.data.summary} intensity={0.6}>
  <article class="fiche">
    <header class="shell fiche__head">
      <Reveal>
        <a href="/logiciels" class="fiche__back">← Tous les logiciels</a>
      </Reveal>

      <Reveal delay={80} class="fiche__title-row">
        <span class="fiche__glyph" data-accent={entry.data.accent} aria-hidden="true">
          {entry.data.glyph}
        </span>
        <div>
          <h1>{entry.data.title}</h1>
          <div class="fiche__badges">
            <StatusPill status={entry.data.status} />
            {entry.data.year && <span class="fiche__year">{entry.data.year}</span>}
          </div>
        </div>
      </Reveal>

      <Reveal delay={160}>
        <p class="fiche__summary">{entry.data.summary}</p>
      </Reveal>

      {
        entry.data.highlights.length > 0 && (
          <Reveal delay={240}>
            <ul class="fiche__highlights">
              {entry.data.highlights.map((h) => (
                <li>
                  <span aria-hidden="true">◆</span>
                  {h}
                </li>
              ))}
            </ul>
          </Reveal>
        )
      }

      {
        (entry.data.repo || entry.data.download) && (
          <Reveal delay={320} class="fiche__actions">
            {entry.data.download && (
              <a href={entry.data.download} class="btn-gold" rel="noopener">
                Télécharger
              </a>
            )}
            {entry.data.repo && (
              <a href={entry.data.repo} class="btn-ghost" target="_blank" rel="noopener">
                Code source
              </a>
            )}
          </Reveal>
        )
      }
    </header>

    <div class="shell fiche__body">
      <div class="fiche__prose prose">
        <Content />
      </div>

      <aside class="fiche__aside">
        <div class="aside-card hairline">
          <h2 class="aside-card__title">Pile technique</h2>
          <ul class="aside-card__stack">
            {entry.data.stack.map((t) => <li>{t}</li>)}
          </ul>
        </div>

        {
          tutoriels.length > 0 && (
            <div class="aside-card hairline">
              <h2 class="aside-card__title">Tutoriels</h2>
              <ul class="aside-card__links">
                {tutoriels.map((t) => (
                  <li>
                    <a href={`/tutoriels/${t.id}`}>
                      <span>{t.data.title}</span>
                      <small>{t.data.duration} min · {t.data.level}</small>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>
  </article>
</Base>

<style>
  .fiche__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    padding-block: clamp(3rem, 8vw, 6rem) 3rem;
  }

  .fiche__back {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-500);
    transition: color 0.25s;
  }
  .fiche__back:hover { color: var(--color-gold-300); }

  .fiche__title-row { display: flex; align-items: center; gap: 1.5rem; }
  .fiche__glyph {
    font-size: 3rem;
    line-height: 1;
    color: var(--accent, var(--color-gold-500));
    filter: drop-shadow(0 0 24px color-mix(in oklab, var(--accent, var(--color-gold-500)) 55%, transparent));
  }
  .fiche__glyph[data-accent='plasma'] { --accent: var(--color-plasma-400); }
  .fiche__glyph[data-accent='nebula'] { --accent: var(--color-nebula-500); }
  .fiche__glyph[data-accent='ember'] { --accent: var(--color-ember-500); }

  .fiche__title-row h1 { font-size: var(--step-4); }
  .fiche__badges { display: flex; align-items: center; gap: 0.75rem; margin-top: 0.6rem; }
  .fiche__year {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--color-ink-500);
  }

  .fiche__summary {
    max-width: 54ch;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--color-ink-300);
  }

  .fiche__highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    list-style: none;
  }
  .fiche__highlights li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.88rem;
    color: var(--color-ink-300);
  }
  .fiche__highlights span { color: var(--color-gold-500); font-size: 0.6rem; }

  .fiche__actions { display: flex; flex-wrap: wrap; gap: 0.85rem; }

  .fiche__body {
    display: grid;
    gap: 3rem;
    grid-template-columns: 1fr;
    padding-bottom: 4rem;
  }
  @media (width >= 62rem) {
    .fiche__body { grid-template-columns: minmax(0, 1fr) 18rem; gap: 4rem; }
  }

  .fiche__aside { display: flex; flex-direction: column; gap: 1rem; }
  @media (width >= 62rem) {
    /* La colonne suit la lecture sans jamais déborder de l'écran. */
    .fiche__aside { position: sticky; top: 7rem; align-self: start; }
  }

  .aside-card {
    padding: 1.4rem;
    border-radius: 14px;
    background: color-mix(in oklab, var(--color-hull) 55%, transparent);
  }
  .aside-card__title {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-gold-500);
    margin-bottom: 0.9rem;
  }
  .aside-card__stack { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; }
  .aside-card__stack li {
    padding: 0.22rem 0.6rem;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-ink-300);
    background: color-mix(in oklab, var(--color-slate-700) 50%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-slate-500) 40%, transparent);
  }

  .aside-card__links { display: grid; gap: 0.9rem; list-style: none; }
  .aside-card__links a { display: grid; gap: 0.15rem; color: var(--color-ink-100); font-size: 0.9rem; }
  .aside-card__links a:hover span { color: var(--color-gold-200); }
  .aside-card__links small {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--color-ink-500);
  }
</style>
