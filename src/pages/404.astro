---
import Base from '../layouts/Base.astro';
import Reveal from '../components/Reveal.astro';
---

<Base title="Page introuvable" description="Cette page n’existe pas." intensity={1}>
  <section class="perdu shell">
    <Reveal>
      <p class="perdu__code">404</p>
    </Reveal>
    <Reveal delay={120}>
      <h1>Cette page a <em class="gilded">quitté l’orbite</em>.</h1>
    </Reveal>
    <Reveal delay={220}>
      <p class="perdu__lead">
        L’adresse ne correspond à rien de connu. Soit le lien est ancien, soit
        la page n’a jamais existé.
      </p>
    </Reveal>
    <Reveal delay={320} class="perdu__actions">
      <a href="/" class="btn-gold">Retour à l’accueil</a>
      <a href="/logiciels" class="btn-ghost">Voir les logiciels</a>
    </Reveal>
  </section>
</Base>

<style>
  .perdu {
    min-height: 72svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 1.2rem;
    padding-block: 6rem;
  }
  .perdu__code {
    font-family: var(--font-display);
    font-size: clamp(6rem, 22vw, 14rem);
    line-height: 0.85;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in oklab, var(--color-gold-400) 55%, transparent);
  }
  .perdu h1 { font-size: var(--step-3); max-width: 18ch; }
  .perdu h1 em { font-style: italic; }
  .perdu__lead { max-width: 42ch; color: var(--color-ink-500); }
  .perdu__actions { display: flex; flex-wrap: wrap; gap: 0.85rem; justify-content: center; margin-top: 0.75rem; }
</style>
